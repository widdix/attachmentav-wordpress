#. Plugin Name of the plugin
#: attachmentav.php
msgid "attachmentAV"
msgstr "attachmentAV"

#. Plugin URI of the plugin
#: attachmentav.php
msgid "https://attachmentav.com/solution/malware-protection-for-wordpress/"
msgstr "https://attachmentav.com/solution/malware-protection-for-wordpress/"

#. Description of the plugin
#: attachmentav.php
msgid "Protect your blog from malware. Scan attachments for viruses, worms, and trojans by sending them to the attachmentAV API powered by Sophos. To get started, please go to your <a href=\"/wp-admin/admin.php?page=attachmentav\">attachmentAV Settings page</a> to set up your API key."
msgstr "Protégez votre blog contre les logiciels malveillants. Les pièces jointes sont analysées à la recherche de virus, vers et chevaux de Troie en les envoyant à l'API attachmentAV (propulsée par Sophos). Pour commencer, rendez-vous sur la <a href=\"/wp-admin/admin.php?page=attachmentav\">page de réglages attachmentAV</a> pour configurer votre clé d'API."

#. Author of the plugin
#: attachmentav.php
msgid "widdix GmbH"
msgstr "widdix GmbH"

#. translators: %s: error message(s) returned by the scan request
#: includes/class-attachmentav-loader.php:145
#, php-format
msgid "attachmentAV: Failed to scan uploaded file for malware (%s)."
msgstr "attachmentAV : Échec de l'analyse anti-malware du fichier téléversé (%s)."

#: includes/class-attachmentav-loader.php:150
msgid "attachmentAV: Could not scan file (e.g., encrypted files). Upload blocked."
msgstr "attachmentAV : Impossible d'analyser le fichier (p. ex. fichiers chiffrés). Téléversement bloqué."

#. translators: %s: name of the malware finding
#: includes/class-attachmentav-loader.php:153
#, php-format
msgid "attachmentAV: Uploaded file is infected (%s). Upload blocked."
msgstr "attachmentAV : Le fichier téléversé est infecté (%s). Téléversement bloqué."

#: includes/class-attachmentav-loader.php:156
msgid "attachmentAV: Could not scan uploaded file for malware as license key is missing or invalid."
msgstr "attachmentAV : Impossible d'analyser le fichier téléversé, car la clé de licence est manquante ou non valide."

#: includes/class-attachmentav-loader.php:158
#: includes/class-attachmentav-loader.php:523
#: includes/class-attachmentav-loader.php:609
msgid "attachmentAV: You've reached the maximum number of malware scans."
msgstr "attachmentAV : Le nombre maximal d'analyses anti-malware est atteint."

#: includes/class-attachmentav-loader.php:160
msgid "attachmentAV: Failed to scan uploaded file for malware due to unknown error."
msgstr "attachmentAV : Échec de l'analyse anti-malware du fichier téléversé en raison d'une erreur inconnue."

#: includes/class-attachmentav-loader.php:165
msgid "attachmentAV: Could not scan file as it exceeds the maximum of 10 MB. Upload blocked. Go to settings and allow uploading unscannable files."
msgstr "attachmentAV : Impossible d'analyser le fichier, car il dépasse le maximum de 10 Mo. Téléversement bloqué. Dans les réglages, vous pouvez autoriser le téléversement des fichiers non analysables."

